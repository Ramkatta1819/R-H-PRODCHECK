{
  "appId": "com.bavya.hcm",
  "appName": "BAVYA HCM Mobile",
  "webDir": "dist",
  "server": {
    "cleartext": true,
    "androidScheme": "http",
    "allowNavigation": [
      "http://*",
      "https://*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0F172A",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
